{
  "description": "Claude Lean hooks. The output filter (squeeze_hook.py) is left out: its rewritten command would need a permission rule a plugin cannot add. Use `npx claude-lean init` for it.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_guard.py\"" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff_hook.py\"" }] },
      { "matcher": "startup|clear|compact",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/terse_hook.py\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cache_guard.py\"" }] },
      { "matcher": "WebSearch",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/web_guard.py\"" }] }
    ]
  }
}
