{
  "name": "claude-lean",
  "version": "0.2.8",
  "description": "Make Claude Code cheaper without losing quality: 22% less on the THOL leaderboard tasks (35% on heavy ones), every task passing. Slim prompt, output budget, web search and read guards, MCP compaction, cost report. Open source, no telemetry.",
  "bin": {
    "claude-lean": "bin/cli.js"
  },
  "files": [
    "bin/",
    "hooks/",
    "tools/",
    "skills/",
    "agents/",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!**/__pycache__"
  ],
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --test tests/cli.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "llm",
    "ai",
    "tokens",
    "token-optimization",
    "cost",
    "prompt-caching",
    "context",
    "hooks",
    "mcp",
    "agents",
    "claude-code-plugin",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobTheJacobs/claude-lean.git"
  },
  "bugs": "https://github.com/JacobTheJacobs/claude-lean/issues",
  "homepage": "https://github.com/JacobTheJacobs/claude-lean#readme",
  "author": "JacobTheJacobs",
  "license": "MIT"
}
